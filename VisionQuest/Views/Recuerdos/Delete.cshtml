@model VisionQuest.Models.Recuerdo

@{
    ViewBag.Title = "Eliminar";
}

<h2>Eliminar</h2>

<h3>¿Está seguro de que desea eliminar este registro?</h3>
<div>
    <h4>Recuerdo</h4>
    <hr />
    <dl class="dl-horizontal">
        <dt>Sintezoide</dt>
        <dd>@Html.DisplayFor(model => model.Sintezoide.Nombre)</dd>

        <dt>
            @Html.DisplayNameFor(model => model.TituloRecuerdo)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.TituloRecuerdo)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.TipoRecuerdo)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.TipoRecuerdo)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.Claridad)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.Claridad)
        </dd>

    </dl>

    @using (Html.BeginForm()) {
        @Html.AntiForgeryToken()

        <div class="form-actions no-color">
            <input type="submit" value="Eliminar" class="btn btn-primary" /> |
            @Html.ActionLink("Volver a la lista", "Index")
        </div>
    }
</div>
