@model IEnumerable<VisionQuest.Models.Recuerdo>

@{
    ViewBag.Title = "Recuerdos";
}

<h2>Recuerdos</h2>

<p>
    @Html.ActionLink("Crear nuevo", "Create")
</p>
<table class="table">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.TituloRecuerdo)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.TipoRecuerdo)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Claridad)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.SintezoideId)
        </th>
        <th></th>
    </tr>

@foreach (var item in Model) {
    <tr>
        <td>
            @Html.DisplayFor(modelItem => item.TituloRecuerdo)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.TipoRecuerdo)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Claridad)
        </td>
        <td>
            @(item.Sintezoide == null ? "" : item.Sintezoide.Nombre)
        </td>
        <td>
            @Html.ActionLink("Editar", "Edit", new { id = item.Id }) |
            @Html.ActionLink("Detalles", "Details", new { id = item.Id }) |
            @Html.ActionLink("Eliminar", "Delete", new { id = item.Id })
        </td>
    </tr>
}

</table>
